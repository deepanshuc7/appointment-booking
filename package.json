{
  "name": "appointment-booking",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "cd apps/customer-web && bun run dev",
    "dev:provider": "cd apps/provider-web && bun run dev",
    "dev:api": "cd apps/api && bun run dev",
    "test": "bun --filter '*' test"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
