{
  "name": "appointment-booking",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "cd apps/customer-web && bun run dev",
    "dev:provider": "cd apps/provider-web && bun run dev",
    "dev:api": "cd apps/api && bun run dev",
    "test": "bun --filter '*' test",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.9.9"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
